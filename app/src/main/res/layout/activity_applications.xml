<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp">

    <!-- Branding -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JOBTRACK SA"
        android:textColor="#16A6A0"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <!-- Page heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="My Applications"
        android:textColor="#142B4A"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvApplicationCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0 applications"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:indeterminateTint="#16A6A0"
        android:visibility="gone" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="No applications yet.\nStart tracking your first opportunity."
        android:textColor="#64748B"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        android:visibility="gone" />

    <!-- Applications list -->
    <ListView
        android:id="@+id/listApplications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:divider="#F5F7FA"
        android:dividerHeight="12dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none" />

</LinearLayout>

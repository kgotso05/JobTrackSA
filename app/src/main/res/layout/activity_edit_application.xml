<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JOBTRACK SA"
            android:textColor="#16A6A0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Edit Application"
            android:textColor="#142B4A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Update the opportunity details or application status."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="OPPORTUNITY DETAILS"
            android:textColor="#142B4A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/etEditCompanyName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#CBD5E1"
            android:hint="Company name"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#142B4A"
            android:textColorHint="#94A3B8" />

        <EditText
            android:id="@+id/etEditJobTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#CBD5E1"
            android:hint="Job title"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#142B4A"
            android:textColorHint="#94A3B8" />

        <EditText
            android:id="@+id/etEditLocation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#CBD5E1"
            android:hint="Location"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#142B4A"
            android:textColorHint="#94A3B8" />

        <EditText
            android:id="@+id/etEditSourceUrl"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#CBD5E1"
            android:hint="Application URL"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#142B4A"
            android:textColorHint="#94A3B8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="APPLICATION STATUS"
            android:textColor="#142B4A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <Spinner
            android:id="@+id/spinnerEditStatus"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#CBD5E1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="IMPORTANT DATES"
            android:textColor="#142B4A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/etEditClosingDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#CBD5E1"
            android:hint="Closing date (YYYY-MM-DD)"
            android:inputType="date"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#142B4A"
            android:textColorHint="#94A3B8" />

        <EditText
            android:id="@+id/etEditDateApplied"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#CBD5E1"
            android:hint="Date applied (YYYY-MM-DD)"
            android:inputType="date"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#142B4A"
            android:textColorHint="#94A3B8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ADDITIONAL NOTES"
            android:textColor="#142B4A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/etEditNotes"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#CBD5E1"
            android:gravity="top"
            android:hint="Update your notes..."
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="#142B4A"
            android:textColorHint="#94A3B8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateApplication"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="Update Application"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#142B4A"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#142B4A"
            android:textSize="14sp"
            app:backgroundTint="#E8EDF3"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
